Процедура ДобавитьИнструменты(Инструменты) Экспорт
	МассивПараметров = Новый Массив;
	
	// Добавляем параметры
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"text", "string", "текст запроса к базе на языке 1С", , Истина));
	
	// Создаем схему
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	// Добавляем инструмент
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты, "custom_query", "Произвольный запроса к БД на языке 1С", СхемаПараметров);
КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	Если ИмяИнструмента = "custom_query" Тогда
        ТекстЗапроса = Аргументы.text;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		
		ТЗЗапроса = Запрос.Выполнить().Выгрузить();
		
		РезультатЗапросаJSON = ТаблицаЗначенийВСтрокуJSON(ТЗЗапроса);
		
		Возврат РезультатЗапросаJSON;
	КонецЕсли;
	
	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
КонецФункции

// Функция для сериализации ТЗ в строку JSON
Функция ТаблицаЗначенийВСтрокуJSON(ТЗ) Экспорт
    МассивДанных = Новый Массив;
    
    Для Каждого СтрокаТЗ Из ТЗ Цикл
        СтруктураСтроки = Новый Структура;
        // Перебираем все колонки ТЗ и добавляем их в структуру
        Для Каждого Колонка Из ТЗ.Колонки Цикл
            СтруктураСтроки.Вставить(Колонка.Имя, СтрокаТЗ[Колонка.Имя]);
        КонецЦикла;
        МассивДанных.Добавить(СтруктураСтроки);
    КонецЦикла;
    
    // Сериализуем полученный массив в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, МассивДанных, , "УниверсальноеПреобразованиеJSON", Обработки.mcp_custom_query);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция УниверсальноеПреобразованиеJSON(ИмяСвойства, Значение, ДополнительныеПараметры, Отказ) Экспорт
    
    Если Значение = Null Тогда
        Возврат Null; // JSON null
    КонецЕсли;
    
    ТипЗначения = ТипЗнч(Значение);
    
    // Пытаемся найти объект метаданных по типу
    ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
    
    Если ОбъектМетаданных <> Неопределено Тогда
        // 1. Обработка всех видов ссылочных объектов
        Если Метаданные.Справочники.Содержит(ОбъектМетаданных)
           ИЛИ Метаданные.Документы.Содержит(ОбъектМетаданных)
           ИЛИ Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных)
           ИЛИ Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных)
           ИЛИ Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных)
           ИЛИ Метаданные.БизнесПроцессы.Содержит(ОбъектМетаданных)
           ИЛИ Метаданные.Задачи.Содержит(ОбъектМетаданных)
           ИЛИ Метаданные.ПланыОбмена.Содержит(ОбъектМетаданных)
           ИЛИ Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
            
            Результат = Новый Структура;
            Результат.Вставить("GUID", Строка(Значение.УникальныйИдентификатор()));
            Результат.Вставить("Type", Строка(ТипЗначения));
            Результат.Вставить("Presentation", Строка(Значение));
            Возврат Результат;
            
        // Можно добавить обработку других объектов метаданных (например, Константы)
        КонецЕсли;
    КонецЕсли;
    
    // 2. Обработка типа УникальныйИдентификатор
    Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда
        Возврат Строка(Значение);
        
    // 3. Обработка ХранилищаЗначения
    ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Тогда
        ДвоичныеДанные = Значение.Получить();
        Возврат Base64Строка(ДвоичныеДанные);
        
    // 4. Обработка ДвоичныхДанных
    ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
        Возврат Base64Строка(Значение);
        
    // 5. Обработка Типа и ОписанияТипов
    ИначеЕсли ТипЗначения = Тип("Тип") Тогда
        Возврат Строка(Значение);
    ИначеЕсли ТипЗначения = Тип("ОписаниеТипов") Тогда
        МассивТипов = Новый Массив;
        Для Каждого ТипИзОписания Из Значение.Типы() Цикл
            МассивТипов.Добавить(Строка(ТипИзОписания));
        КонецЦикла;
        Возврат МассивТипов;
        
    КонецЕсли;
    
    // Если тип не был обработан, возвращаем строковое представление
    Возврат "[Несериализуемый тип: " + Строка(ТипЗначения) + "]";

КонецФункции
